# MedRAG environment variables
# Copy this file to .env for local development, and keep your live secrets in .env.local.

# Groq API key used by the chat and evaluation flows
GROQ_API_KEY=gsk_******************************

# Optional model override for the Groq chat path
GROQ_MODEL=llama-3.1-8b-instant

# Optional base URL for the evaluation script to call the backend
MEDRAG_API_URL=http://127.0.0.1:8000